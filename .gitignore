.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# Turbo
.turbo/

# python
__pycache__/

# idea files
.idea

# project-specific
.env.test
.env.e2e
.env.quickstart
.local-db-secret

# Claude Code per-developer settings (the shared settings.json is committed)
.claude/settings.local.json

# Prisma client output (configured in packages/db/prisma/schema.prisma)
/packages/db/generated/

# Local git worktrees
/.worktrees/

# Local agent working state
/.superpowers/

# per-env document/git data dirs
/data/
/data-test/
/data-e2e/

# pnpm fallback store (created when a sandboxed agent cannot write to ~/Library/pnpm)
/.pnpm-store/

# Local Rust notebook reader build
/packages/ingestion/native/onenote-reader/target/

.env.*
!.env.example
