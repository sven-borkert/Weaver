# Local Postgres (see docs/setup.md Options A/B). With a host installation,
# ./scripts/provision-databases.sh creates the weaver role and the
# weaver/weaver_test/weaver_e2e databases there. Without a local Postgres,
# ./start-database.sh starts a dev container that only creates the DB named in
# DATABASE_URL (weaver_test/weaver_e2e must be created in it manually).
DATABASE_URL="postgresql://postgres:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/weaver?schema=public"
AUTH_SECRET="run-openssl-rand-base64-32-and-paste-here"
# Public HTTPS origin; required in production (HTTP is accepted only for loopback).
# AUTH_URL="https://host.example.com"
NODE_ENV="development"
# Overrides Better Auth's default (rate limiting on for production, off otherwise).
# WEAVER_AUTH_RATE_LIMIT_ENABLED=true

# Optional OIDC environment fallback; prefer Administration > Settings > OIDC.
# Set all three together; recreate web after environment edits. Saved settings override these.
# Register <AUTH_URL><base path>/api/auth/callback/oidc as the exact redirect URI.
# WEAVER_OIDC_DISCOVERY_URL="https://auth.example.com/application/o/weaver/.well-known/openid-configuration"
# WEAVER_OIDC_CLIENT_ID="weaver"
# WEAVER_OIDC_CLIENT_SECRET="replace-with-provider-client-secret"
# WEAVER_OIDC_DISPLAY_NAME="Authentik"

# MCP protected-resource URL access tokens are bound to (defaults to <AUTH_URL><base path>/api/mcp).
# Better Auth rejects plain http:// except on loopback, so production needs https://.
# WEAVER_MCP_RESOURCE_URL="https://host.example.com/api/mcp"
# Local MCP development: point clients (and token audiences) straight at the mcp-server.
# Production leaves this unset so the default <AUTH_URL><base path>/api/mcp applies.
# WEAVER_MCP_RESOURCE_URL="http://127.0.0.1:3200/mcp"
# OAuth issuer expected by the mcp-server; defaults to <AUTH_URL origin><base path>/api/auth.
# WEAVER_OAUTH_ISSUER="https://host.example.com/api/auth"
# MCP runtime (apps/mcp-server): port, extra allowed Host/Origin hostnames, caps and limits.
WEAVER_MCP_PORT=3200
# Keep false except for the private Traefik-only Compose listener.
WEAVER_MCP_TRUST_PROXY=false
# Enable only behind a private proxy that overwrites X-Real-IP.
WEAVER_AUTH_TRUST_PROXY=false
# Without a trusted client-IP source, auth skips IP rate limiting.
# WEAVER_MCP_ALLOWED_HOSTS="mcp.internal"
# WEAVER_MCP_ALLOWED_ORIGINS="app.example.com"
WEAVER_MCP_MAX_BODY_BYTES=1048576
WEAVER_MCP_MAX_RESOURCE_CHARS=200000
WEAVER_MCP_TOOL_TIMEOUT_MS=30000
WEAVER_MCP_RATE_LIMIT_PER_MINUTE=600
WEAVER_MCP_ANON_RATE_LIMIT_PER_MINUTE=60

# Versioned AES-256-GCM key ring for stored provider credentials (LLM connections).
# "<version>:<base64 32 bytes>[,<version>:<base64 32 bytes>]"; the highest version
# encrypts new secrets, every listed key may decrypt. Generate: openssl rand -base64 32
WEAVER_ENCRYPTION_KEYS="1:REPLACE_WITH_BASE64_32_BYTE_KEY"

# Postgres pool size (pg default 10) and per-statement timeout in ms (0 = disabled).
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=0

# Directory for per-project git repositories and file storage.
# Dev uses ./data; .env.test/.env.e2e MUST point at ./data-test / ./data-e2e.
WEAVER_DATA_DIR="./data"
WEAVER_GIT_LOCK_TIMEOUT_MS=10000
WEAVER_WORKER_HEALTH_PORT=3101
WEAVER_GIT_LOCK_POOL_MAX=4
# Ingestion (Phase 5A). Largest accepted upload, and how long an abandoned
# multipart upload may sit in files/<projectId>/tmp/ before it is swept.
WEAVER_INGESTION_MAX_FILE_BYTES=52428800
# Files (including OneNote notebooks) have a separate 512 MiB upload/read cap.
WEAVER_ARTIFACT_MAX_FILE_BYTES=536870912
# Optional absolute path to a prebuilt reader; otherwise run pnpm notebook:build.
# WEAVER_ONENOTE_READER_PATH=/usr/local/bin/weaver-onenote-reader
WEAVER_INGESTION_TMP_TTL_MINUTES=60
# Documents. Largest image accepted for upload into a document (10 MiB).
WEAVER_DOCUMENT_IMAGE_MAX_BYTES=10485760
# PDF export: Chromium render cap (ms). Set WEAVER_CHROMIUM_PATH when Chromium is not
# the Playwright-managed one; the Docker image sets both and WEAVER_CHROMIUM_NO_SANDBOX=true.
WEAVER_PDF_TIMEOUT_MS=30000
# WEAVER_CHROMIUM_PATH=/usr/bin/chromium
# WEAVER_CHROMIUM_NO_SANDBOX=true
# Vision-model calls per imported file for scanned PDF pages and images (0 disables OCR).
WEAVER_INGESTION_MAX_OCR_PAGES=50
# External feed (Phase 5D): submissions per minute one personal API key may push
# to POST /api/ingestion/external (in-process window, like the MCP limiter).
WEAVER_INGESTION_EXTERNAL_RATE_LIMIT_PER_MINUTE=60
# pg-boss consumers this worker registers: knowledge, assistant, ingestion, tasks, git (comma-separated).
# docker-compose runs two workers from one image: knowledge,assistant,tasks,git and ingestion.
WEAVER_WORKER_ROLES=knowledge,assistant,ingestion,tasks,git
# Deployment-wide union, identical on every worker; removes cron schedules for excluded roles.
WEAVER_ENABLED_WORKER_ROLES=knowledge,assistant,ingestion,tasks,git

# Phase 3 indexing jobs. AI remains disabled unless explicitly configured.
WEAVER_JOBS_ENABLED=true
WEAVER_JOB_WORKER_CONCURRENCY=2
WEAVER_KNOWLEDGE_RECONCILE_CRON="*/15 * * * *"
# Assistant-run recovery: keep it close to the 30 s attempt lease.
WEAVER_ASSISTANT_RECONCILE_CRON="* * * * *"
# Scheduled AI tasks are claimed by a minute tick; leave at every minute.
WEAVER_TASK_TICK_CRON="* * * * *"
# LLM providers are configured in Administration › AI (encrypted with WEAVER_ENCRYPTION_KEYS).

# Optional subpath the app is served under in production (e.g. "/weaver"); also scopes auth cookies.
# NEXT_PUBLIC_BASE_PATH=/weaver

# One-time first Admin for a fresh deployment (pnpm db:bootstrap-admin); no-op once any user exists.
# WEAVER_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# WEAVER_BOOTSTRAP_ADMIN_PASSWORD="at-least-twelve-characters"
# WEAVER_BOOTSTRAP_ADMIN_NAME="Administrator"

# Independent MCP operation locks (concurrent writes across projects).
WEAVER_MCP_OPERATION_LOCK_POOL_MAX=16

# Outbound LLM, Docling and external MCP calls default to public HTTPS with DNS pinning.
# Explicitly trust private/plain-HTTP service origins; no paths, wildcards, or trailing slashes.
# Example: "http://ollama:11434,http://docling:5001,https://mcp.internal"
WEAVER_OUTBOUND_ALLOWED_ORIGINS=""
# Exact host:port exceptions for private SSH Git remotes (for example git.internal:22).
WEAVER_GIT_ALLOWED_SSH_TARGETS=""
# Retained upload bytes per project (5 GiB) and required free space (1 GiB).
WEAVER_INGESTION_PROJECT_QUOTA_BYTES=5368709120
WEAVER_INGESTION_MIN_FREE_BYTES=1073741824

# Separate durable project API operation lock pool (1–128).
WEAVER_PROJECT_API_OPERATION_LOCK_POOL_MAX=2
