# web.env (mode 0600) next to docker-compose.yml: container environment for
# every Weaver service and the values Compose interpolates for
# `docker compose --env-file web.env up -d` (docs/setup.md, "Run from registry images").
NODE_ENV=production

# Registry images: change the tag to pin a release (docs/setup.md).
WEAVER_IMAGE_PREFIX=registry.example.com/weaver
WEAVER_IMAGE_TAG=latest
# The web image is built for this base path; another value needs a rebuild.
WEAVER_BASE_PATH=/weaver
WEAVER_WEB_PORT=3000
WEAVER_MCP_PORT=3200

# Public origin only; the application path comes from WEAVER_BASE_PATH.
AUTH_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
# Same value as the pg_password file; generate it with `openssl rand -hex 32`.
DATABASE_URL=postgresql://weaver:REPLACE_WITH_PG_PASSWORD@postgres:5432/weaver?schema=public
# Versioned key ring for stored LLM credentials: 1:$(openssl rand -base64 32)
WEAVER_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
WEAVER_DATA_DIR=/data

WEAVER_JOBS_ENABLED=true
# Private-range LLM, Docling, and MCP origins must be listed explicitly (exact origins, no paths).
WEAVER_OUTBOUND_ALLOWED_ORIGINS=
