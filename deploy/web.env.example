# /srv/weaver/web.env (mode 0600): container environment for every Weaver service
# and Compose interpolation (weaver-compose-up passes it as --env-file).
NODE_ENV=production

# Compose: deploy root and Traefik routing on the shared host.
WEAVER_DEPLOY_ROOT=/srv/weaver
WEAVER_PUBLIC_HOST=weaver.example.com
WEAVER_BASE_PATH=/weaver
WEAVER_TRAEFIK_NETWORK=ingress
WEAVER_TLS_CERTRESOLVER=letsencrypt
WEAVER_IMAGE_PREFIX=registry.example.com/weaver
# WEAVER_IMAGE_TAG=latest   # pin a short sha or version to roll back or freeze

# Public origin only; the application path comes from WEAVER_BASE_PATH.
AUTH_URL=https://weaver.example.com
# openssl rand -base64 32
AUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
# Same value as pg_password; generate it with `openssl rand -hex 32` so it needs no URL encoding.
DATABASE_URL=postgresql://weaver:REPLACE_WITH_PG_PASSWORD@postgres:5432/weaver?schema=public
# Versioned key ring for stored LLM/OIDC credentials: 1:$(openssl rand -base64 32)
WEAVER_ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
WEAVER_DATA_DIR=/data

WEAVER_JOBS_ENABLED=true
# Configure OIDC under Administration > Settings > OIDC (no restart needed).
# Private-range OIDC, LLM, Docling, and MCP origins must be listed explicitly (exact origins, no paths).
# Public providers such as OpenRouter need no entry.
# Upgrades: GitLab API and URL-encoded project path that weaver-upgrade fetches from.
WEAVER_GITLAB_API=https://gitlab.example.com/api/v4
WEAVER_GITLAB_PROJECT=group%2Fweaver

WEAVER_OUTBOUND_ALLOWED_ORIGINS=
